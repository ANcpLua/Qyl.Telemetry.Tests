<Project>
  <PropertyGroup><ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally></PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="JetBrains.Annotations" Version="$(JetBrainsAnnotationsVersion)" />
    <PackageVersion Include="Fallout.Common" Version="$(FalloutVersion)" />
    <PackageVersion Include="DotCov" Version="$(DotCovVersion)" />
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="$(DotNetRuntimeVersion)" />
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="$(DotNetRuntimeVersion)" />
    <PackageVersion Include="Qyl.Telemetry.SemanticConventions" Version="$(QylSemanticConventionsVersion)" />
    <PackageVersion Include="Qyl.Telemetry.SemanticConventions.Incubating" Version="$(QylSemanticConventionsVersion)" />
    <PackageVersion Include="Qyl.Telemetry.Hosting" Version="$(QylTelemetryVersion)" />
    <PackageVersion Include="Qyl.Orchestration" Version="$(QylPlatformVersion)" />
    <PackageVersion Include="Qyl.Api.Contracts" Version="$(QylApiContractsVersion)" />
    <PackageVersion Include="Google.Api.CommonProtos" Version="$(GoogleApiCommonProtosVersion)" />
    <PackageVersion Include="Google.Protobuf" Version="$(GoogleProtobufVersion)" />
    <PackageVersion Include="Grpc.AspNetCore.Server" Version="$(GrpcVersion)" />
    <PackageVersion Include="Grpc.Tools" Version="$(GrpcVersion)" />
    <PackageVersion Include="Grpc.Net.Client" Version="$(GrpcVersion)" />
    <PackageVersion Include="OpenTelemetry" Version="$(OpenTelemetryVersion)" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="$(OpenTelemetryVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="$(DotNetRuntimeVersion)" />
    <PackageVersion Include="ModelContextProtocol" Version="$(ModelContextProtocolVersion)" />
  </ItemGroup>
</Project>
