<Project Sdk="MSTest.Sdk">
  <PropertyGroup>
    <UsesQylCollector>true</UsesQylCollector>
    <!-- The intentionally failing child stays outside the solution but inherits its parent's configuration. -->
    <ShouldUnsetParentConfigurationAndPlatform>false</ShouldUnsetParentConfigurationAndPlatform>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Qyl.Telemetry.Tests/Qyl.Telemetry.Tests.csproj" />
    <ProjectReference Include="../../services/qyl.collector/qyl.collector.csproj" />
    <!-- Keep Collector-generated OTLP models separate from the receiver wire models. -->
    <ProjectReference Include="../../services/qyl.collector.ingestion/qyl.collector.ingestion.csproj" Aliases="CollectorProtocol" />
    <ProjectReference Include="Fixtures/TelemetryInvocation.Probe/TelemetryInvocation.Probe.csproj" ReferenceOutputAssembly="false" />
    <TestFixtureProject Include="Fixtures/TelemetryInvocation.Probe/TelemetryInvocation.Probe.csproj" />
    <PackageReference Include="Grpc.Net.Client" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>
  <ItemGroup>
    <None Update="Contracts/Fixtures/*.json" CopyToOutputDirectory="PreserveNewest" />
    <Compile Remove="Fixtures/**/*.cs" />
    <Compile Include="Fixtures/TelemetryInvocation.Probe/ProbeContract.cs" Link="Probes/ProbeContract.cs" />
  </ItemGroup>
  <!-- The Collector uses its own OTLP types behind its API; transport fixtures use their local protocol types. -->
  <Target Name="IsolateCollectorProtocolTypes" BeforeTargets="CoreCompile">
    <ItemGroup>
      <ReferencePath Update="@(ReferencePath)" Condition="'%(Filename)' == 'qyl.collector.ingestion'">
        <Aliases>CollectorIngestion</Aliases>
      </ReferencePath>
      <ReferencePathWithRefAssemblies Update="@(ReferencePathWithRefAssemblies)" Condition="'%(Filename)' == 'qyl.collector.ingestion'">
        <Aliases>CollectorIngestion</Aliases>
      </ReferencePathWithRefAssemblies>
    </ItemGroup>
  </Target>
</Project>
