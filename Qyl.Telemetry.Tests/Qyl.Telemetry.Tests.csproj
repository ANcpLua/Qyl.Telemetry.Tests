<Project Sdk="MSTest.Sdk">
  <PropertyGroup>
    <IsTestApplication>false</IsTestApplication>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Qyl.Telemetry.ProcessHost/Qyl.Telemetry.ProcessHost.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../Qyl.Telemetry.Tests.Capture/Qyl.Telemetry.Tests.Capture.csproj" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="../../Qyl.Telemetry.SemanticConventions/src/Qyl.Telemetry.SemanticConventions/Qyl.Telemetry.SemanticConventions.csproj" Condition="Exists('../../Qyl.Telemetry.SemanticConventions/src/Qyl.Telemetry.SemanticConventions/Qyl.Telemetry.SemanticConventions.csproj')" />
    <PackageReference Include="Qyl.Telemetry.SemanticConventions" Condition="!Exists('../../Qyl.Telemetry.SemanticConventions/src/Qyl.Telemetry.SemanticConventions/Qyl.Telemetry.SemanticConventions.csproj')" />
    <PackageReference Include="Qyl.Telemetry.Hosting" />
    <ProjectReference Include="../../packages/Qyl.Orchestration/Qyl.Orchestration.csproj" />
    <ProjectReference Include="../../internal/qyl.contracts/Qyl.Api.Contracts.csproj" />
    <PackageReference Include="Google.Api.CommonProtos" />
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.AspNetCore.Server" />
    <PackageReference Include="Grpc.Tools" PrivateAssets="all" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <Protobuf Include="Protos/**/*.proto" ProtoRoot="Protos" GrpcServices="None" Access="Internal" />
    <InternalsVisibleTo Include="Qyl.Telemetry.UnitTests" />
    <InternalsVisibleTo Include="Qyl.Telemetry.IntegrationTests" />
    <InternalsVisibleTo Include="Qyl.Telemetry.EndToEndTests" />
  </ItemGroup>
  <Target Name="CollectProcessHostPayload"
          BeforeTargets="_GetCopyToOutputDirectoryItemsFromThisProject;GetCopyToPublishDirectoryItems"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <MSBuild Projects="../Qyl.Telemetry.ProcessHost/Qyl.Telemetry.ProcessHost.csproj" Targets="GetTargetPath"
             Properties="$(_LocalDependencyBuildProperties)"
             RemoveProperties="BuildingSolutionFile;CurrentSolutionConfigurationContents;$(_GlobalPropertiesToRemoveFromProjectReferences);$(_JetBrainsProjectReferenceGlobalPropertiesToRemove)">
      <Output TaskParameter="TargetOutputs" ItemName="_ProcessHostTarget" />
    </MSBuild>
    <ItemGroup>
      <_ProcessHostPayload Include="%(_ProcessHostTarget.RootDir)%(_ProcessHostTarget.Directory)**/*" />
      <ContentWithTargetPath Include="@(_ProcessHostPayload)">
        <TargetPath>process-host/%(_ProcessHostPayload.RecursiveDir)%(_ProcessHostPayload.Filename)%(_ProcessHostPayload.Extension)</TargetPath>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ContentWithTargetPath>
    </ItemGroup>
  </Target>
</Project>
